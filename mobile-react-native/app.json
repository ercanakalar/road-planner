{
  "expo": {
    "name": "Travel Routes",
    "slug": "travel-routes",
    "scheme": "net.travelroutes.travelroutes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.travelroutes.travelroutes",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is shown on the map so you can see where you are relative to the stops on a route.",
        "NSPhotoLibraryUsageDescription": "Your photos are used only to set your profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#1967D2"
      },
      "package": "net.travelroutes.travelroutes",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to use your photos so you can set a profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#202124"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "93f8f9b3-7bcd-4cf4-a399-145abf969808"
      }
    }
  }
}
