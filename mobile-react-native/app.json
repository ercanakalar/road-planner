{
  "expo": {
    "name": "Travel Routes",
    "slug": "Travel Routes",
    "scheme": "net.travelroutes.travelroutes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/main-icon.svg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0F172A"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.travelroutes.travelroutes",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is shown on the map so you can see where you are relative to the stops on a route.",
        "NSPhotoLibraryUsageDescription": "Your photos are used only to set your profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "net.travelroutes.travelroutes",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to use your photos so you can set a profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "93f8f9b3-7bcd-4cf4-a399-145abf969808"
      }
    }
  }
}
