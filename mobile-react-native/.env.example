# Copy to .env. Expo inlines EXPO_PUBLIC_* variables into the JS bundle, so
# treat anything here as public.
#
# src/constants/appConfig.ts reads these — see appConfig.example.ts.

# The backend's address, without the /api prefix — the client adds that itself,
# and tolerates it being here anyway. On a phone this has to be an address the
# phone can reach: `localhost` is the phone. Check it in the phone's browser,
# http://<address>/api/health answers.
EXPO_PUBLIC_BASE_URL="http://localhost:3000"



# Optional. Host that shared road links point at, e.g.
# https://roadplanner.example.com/share/<token>. For such a link to open the
# app rather than a browser, that host must serve /.well-known/assetlinks.json
# naming the package net.travelroutes.travelroutes and the signing
# certificate's SHA-256. Left empty, the app shares links of the form
# net.travelroutes.travelroutes://share/<token>, which open the app when
# tapped but which chat apps do not turn into tappable links.
EXPO_PUBLIC_SHARE_LINK_BASE_URL=""

# Google sign-in. One OAuth client per platform, from the same Google Cloud
# project as the backend's GOOGLE_CLIENT_ID — see "Google sign-in" in README.md.
#
# The button is hidden outright when the id for the platform being built is
# missing, and the web id is never substituted for a native one: the token it
# produces would carry the wrong audience and the API would refuse it.
#
# Android clients are keyed by package name *and* signing certificate, so a debug
# build and a release build need one client id each. Only one can be compiled in
# at a time; list both on the backend's GOOGLE_NATIVE_CLIENT_IDS.
#
#   Android   package net.travelroutes.travelroutes + the build's SHA-1
#   iOS       bundle id net.travelroutes.travelroutes
#
# None of these work in Expo Go — Google redirects to the app's own scheme, which
# only a development build or the APK answers to. The app says so rather than
# hanging when it is started from Expo Go.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""