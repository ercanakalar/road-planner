# Copy to .env. Expo inlines EXPO_PUBLIC_* variables into the JS bundle, so
# treat anything here as public and restrict the Google key in the Cloud
# console (Android package + SHA-1, iOS bundle id, and only the Directions,
# Geocoding and Places APIs).
#
# src/constants/appConfig.ts reads these — see appConfig.example.ts.

EXPO_PUBLIC_BASE_URL="http://localhost:3000"
EXPO_PUBLIC_MAP_API_KEY=""

# Native map SDK key, substituted into app.json at prebuild time.
GOOGLE_MAPS_API_KEY=""
