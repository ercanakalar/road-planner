generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ManuelAuth {
  id       String @id @default(uuid())
  email    String @unique @db.Citext
  password String @db.VarChar(255)
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoogleAuth {
  id     String @id @default(uuid())
  email  String @unique @db.Citext
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())

  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordReset {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel PasswordResetChannel @default(LINK)

  codeHash String?

  attempts Int @default(0)

  lockedUntil DateTime?

  verifiedAt DateTime?

  tokenHash String? @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum PasswordResetChannel {
  LINK
  CODE
}

model Permit {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  users       User[]       @relation("UserPermit")
  permissions Permission[] @relation("PermitPermissions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id      String   @id @default(uuid())
  name    String   @unique
  permits Permit[] @relation("PermitPermissions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(uuid())

  email String @unique @db.Citext

  firstName String?
  lastName  String?
  photo     String?
  nickName  String? @unique

  manuelAuth     ManuelAuth?
  googleAuth     GoogleAuth?
  sessions       Session[]
  passwordResets PasswordReset[]

  permitId String?
  permit   Permit? @relation("UserPermit", fields: [permitId], references: [id], onDelete: SetNull)

  roads             Road[]
  favoriteRoads     FavoriteRoad[]
  favoriteWaypoints FavoriteWaypoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([nickName])
}

model Road {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String

  isPublic Boolean @default(false)

  archivedAt DateTime?

  wayPoints     WayPoint[]
  favoriteRoads FavoriteRoad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, archivedAt])
  @@index([isPublic, archivedAt, createdAt])
}

model WayPoint {
  id        String @id @default(uuid())
  latitude  Float
  longitude Float

  order Int

  roadId String
  road   Road   @relation(fields: [roadId], references: [id], onDelete: Cascade)

  addressInfoId String?      @unique
  address       AddressInfo? @relation(fields: [addressInfoId], references: [id], onDelete: SetNull)

  favoriteWaypoints FavoriteWaypoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roadId, order])
}

model AddressInfo {
  id       String  @id @default(uuid())
  country  String?
  province String?
  district String?
  address  String

  wayPoint WayPoint?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country, province, district])
}

model FavoriteRoad {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String?
  description String?

  roadId String
  road   Road   @relation(fields: [roadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roadId])
  @@index([userId])
  @@index([roadId])
}

model FavoriteWaypoint {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String?
  description String?

  waypointId String
  waypoint   WayPoint @relation(fields: [waypointId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, waypointId])
  @@index([userId])
  @@index([waypointId])
}
