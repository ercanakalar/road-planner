generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ManuelAuth {
  id       String @id @default(uuid())
  email    String @unique @db.Citext
  password String @db.VarChar(255)
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoogleAuth {
  id     String @id @default(uuid())
  email  String @unique @db.Citext
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())

  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt])
}

model PasswordReset {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel PasswordResetChannel @default(LINK)

  codeHash String?

  attempts Int @default(0)

  lockedUntil DateTime?

  verifiedAt DateTime?

  tokenHash String? @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum PasswordResetChannel {
  LINK
  CODE
}

model Permit {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  users       User[]       @relation("UserPermit")
  permissions Permission[] @relation("PermitPermissions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id      String   @id @default(uuid())
  name    String   @unique
  permits Permit[] @relation("PermitPermissions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(uuid())

  email String @unique @db.Citext

  firstName String?
  lastName  String?
  photo     String?
  nickName  String? @unique

  manuelAuth     ManuelAuth?
  googleAuth     GoogleAuth?
  sessions       Session[]
  passwordResets PasswordReset[]

  permitId String?
  permit   Permit? @relation("UserPermit", fields: [permitId], references: [id], onDelete: SetNull)

  roads         Road[]
  favoriteRoads FavoriteRoad[]
  favoriteStops FavoriteStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Road {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String

  isPublic Boolean @default(false)

  archivedAt DateTime?

  stops         Stop[]
  favoriteRoads FavoriteRoad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt, id])
  @@index([isPublic, createdAt, id])
}

model Stop {
  id        String @id @default(uuid())
  latitude  Float
  longitude Float

  order Int

  roadId String
  road   Road   @relation(fields: [roadId], references: [id], onDelete: Cascade)

  /// The formatted address Google returned for these coordinates, kept as it
  /// was at save time. It is a label for the pin, not a record of the place:
  /// nothing queries it, and it is refreshed only when the stop is moved.
  address String @default("")

  /// Ground height in metres above sea level, from the Elevation API, resolved
  /// once when the coordinates are set and again when they move. The slope
  /// between consecutive stops is derived from it on read rather than stored: a
  /// stored slope would be wrong the moment a neighbour is added or reordered.
  /// Null means the lookup has not run yet or could not answer.
  elevation Float?

  favoriteStops FavoriteStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roadId, order])
}

model FavoriteRoad {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String?
  description String?

  roadId String
  road   Road   @relation(fields: [roadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roadId])
  @@index([userId, createdAt, id])
  @@index([roadId])
}

model FavoriteStop {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String?
  description String?

  stopId String
  stop   Stop   @relation(fields: [stopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stopId])
  @@index([userId, createdAt, id])
  @@index([stopId])
}
