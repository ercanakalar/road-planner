generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ManuelAuth {
  id       String @id @default(uuid())
  email    String @unique @db.Citext
  password String @db.VarChar(255)
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoogleAuth {
  id     String @id @default(uuid())
  email  String @unique @db.Citext
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())

  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt])
}

model PasswordReset {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel PasswordResetChannel @default(LINK)

  codeHash String?

  attempts Int @default(0)

  lockedUntil DateTime?

  verifiedAt DateTime?

  tokenHash String? @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum PasswordResetChannel {
  LINK
  CODE
}

model Permit {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  users       User[]       @relation("UserPermit")
  permissions Permission[] @relation("PermitPermissions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id      String   @id @default(uuid())
  name    String   @unique
  permits Permit[] @relation("PermitPermissions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(uuid())

  email String @unique @db.Citext

  firstName String?
  lastName  String?
  photo     String?
  nickName  String? @unique

  manuelAuth     ManuelAuth?
  googleAuth     GoogleAuth?
  sessions       Session[]
  passwordResets PasswordReset[]

  permitId String?
  permit   Permit? @relation("UserPermit", fields: [permitId], references: [id], onDelete: SetNull)

  roads         Road[]
  favoriteRoads FavoriteRoad[]
  favoriteStops FavoriteStop[]

  following AuthorFollow[] @relation("FollowsMade")
  followers AuthorFollow[] @relation("FollowsReceived")

  /// Where this person wants to hear about the things they follow. Both are on
  /// by default: they only ever arrive because something was followed on
  /// purpose, and an empty inbox after following somebody reads as broken.
  notifyInApp   Boolean @default(true)
  notifyByEmail Boolean @default(true)

  notifications      Notification[] @relation("NotificationsReceived")
  causedNotifications Notification[] @relation("NotificationsCaused")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Someone asking to hear about an author's next public route.
///
/// One row per (follower, author) pair, created by the follower and readable
/// only through their own account — following is a private subscription, not a
/// public audience an author can enumerate.
model AuthorFollow {
  id String @id @default(uuid())

  followerId String
  follower   User   @relation("FollowsMade", fields: [followerId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("FollowsReceived", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, authorId])
  @@index([authorId])
}

/// What a notification is about. One kind so far; the column exists so a
/// second does not need a migration of every existing row.
enum NotificationKind {
  ROUTE_PUBLISHED
}

/// One line in somebody's inbox.
///
/// Written when something they follow happens, and read only by them. The row
/// holds who and what rather than a rendered sentence, so the wording can
/// change — and be translated — without rewriting anybody's history.
model Notification {
  id String @id @default(uuid())

  /// Whose inbox this is.
  userId String
  user   User   @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)

  kind NotificationKind

  /// Who did the thing. Null once that account is gone, which leaves the line
  /// readable rather than deleting news that already happened.
  actorId String?
  actor   User?   @relation("NotificationsCaused", fields: [actorId], references: [id], onDelete: SetNull)

  /// The route it is about. Deleting the route takes the line with it: there
  /// is nothing left to open.
  roadId String?
  road   Road?   @relation(fields: [roadId], references: [id], onDelete: Cascade)

  readAt DateTime?

  createdAt DateTime @default(now())

  /// Publishing the same route twice is not news twice. The constraint is what
  /// makes the write at publish time safe to repeat.
  @@unique([userId, roadId, kind])
  @@index([userId, createdAt, id])
  @@index([userId, readAt])
}

model Road {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String

  isPublic Boolean @default(false)

  archivedAt DateTime?

  stops         Stop[]
  favoriteRoads FavoriteRoad[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt, id])
  @@index([isPublic, createdAt, id])
}

model Stop {
  id        String @id @default(uuid())
  latitude  Float
  longitude Float

  order Int

  roadId String
  road   Road   @relation(fields: [roadId], references: [id], onDelete: Cascade)

  /// The formatted address Google returned for these coordinates, kept as it
  /// was at save time. It is a label for the pin, not a record of the place:
  /// nothing queries it, and it is refreshed only when the stop is moved.
  address String @default("")

  /// Ground height in metres above sea level, from the Elevation API, resolved
  /// once when the coordinates are set and again when they move. The slope
  /// between consecutive stops is derived from it on read rather than stored: a
  /// stored slope would be wrong the moment a neighbour is added or reordered.
  /// Null means the lookup has not run yet or could not answer.
  elevation Float?

  favoriteStops FavoriteStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roadId, order])
}

model FavoriteRoad {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String?
  description String?

  roadId String
  road   Road   @relation(fields: [roadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roadId])
  @@index([userId, createdAt, id])
  @@index([roadId])
}

model FavoriteStop {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String?
  description String?

  stopId String
  stop   Stop   @relation(fields: [stopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stopId])
  @@index([userId, createdAt, id])
  @@index([stopId])
}
