# Copy to backend/.env.production and fill in. That file is git-ignored; this
# one carries no values.
#
#   cp .env.production.example .env.production
#   scripts/setup-cloudrun.sh     # reads it, creates the secrets
#   scripts/deploy-cloudrun.sh    # reads it, builds and deploys
#
# It is not deployed. Cloud Run has no .env — the scripts read this and split it
# two ways, which is the distinction that matters:
#
#   --set-env-vars   plain values, readable by anyone who can view the service
#   --set-secrets    Secret Manager references, resolved when an instance starts
#
# Anything already exported wins over this file, so a one-off
# `MAX_INSTANCES=8 scripts/deploy-cloudrun.sh` does not need the file edited.
#
# Everything is validated at boot by src/config/env.validation.ts, so a missing
# value fails the revision rather than the first request that needs it.

# ── Where things live ────────────────────────────────────────────────────────
PROJECT_ID="project-name-id"
REGION="us-"

# ── The database: fill in ONE of the two blocks below ────────────────────────
#
# A) A Postgres outside Google Cloud, reached over TLS.
#
# Set the whole connection string as its provider gives it, and leave
# CLOUD_SQL_INSTANCE empty. Nothing Cloud SQL is then created or charged for,
# which is what makes a provider's free tier an option. Keep `sslmode=require`,
# and add `connection_limit=3` — the pool is per Cloud Run instance and there
# may be MAX_INSTANCES of them:
#
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&connection_limit=3"
#
# If the provider offers a pooled endpoint, use it: a service that scales to
# zero and back opens connections in bursts.
DATABASE_URL=""

# B) Cloud SQL, reached over a Unix socket rather than the public internet.
#
# Leave DATABASE_URL empty above and set the instance here; the scripts build
# the URL from it and the DB_ values, which must match the database and user
# that exist on the instance. Cloud SQL has no free tier — the smallest
# instance bills by the hour whether or not anyone opens the app.
CLOUD_SQL_INSTANCE=""

DB_NAME=""
DB_USER=""
DB_PASSWORD=""

# ── Secrets ──────────────────────────────────────────────────────────────────
# Read by setup-cloudrun.sh, written to Secret Manager, and never passed to the
# service as plain environment variables.
#
# ACCESS_KEY, REFRESH_KEY and ROAD_SHARE_KEY are not here: setup generates three
# distinct random values and leaves them alone on later runs. Three different
# values on purpose — one secret shared across token classes would let an access
# token be replayed as a refresh token.
MAIL_PASSWORD=""
# Only for the browser OAuth flow. Native sign-in verifies an id token against
# GOOGLE_NATIVE_CLIENT_IDS below and never sees a secret.
GOOGLE_CLIENT_SECRET=""

# Server-side key for the Directions, Geocoding and Places web services. Billed
# per request, which is why it is a secret and why it never reaches a client —
# the app asks /api/maps/* instead. Leave empty and those endpoints answer 503;
# nothing else is affected. Restrict it in the Cloud console to those three APIs.
MAP_API_KEY=""

# ── Plain environment variables ──────────────────────────────────────────────
MAIL_HOST="sandbox.smtp.mailtrap.io"
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_FROM="destek@travel-routes.com.tr"

# The **Android** OAuth client id, not the web one. The app signs in with the
# Android client, so that is the audience the id token carries. Comma-separate
# several: Android issues one client id per signing certificate, so a release
# build and a debug build need one each, and an iOS build another.
#
# GOOGLE_CLIENT_ID below is accepted as an audience too — it belongs to the same
# project — so this can be left empty if the app is ever changed to ask for a
# token addressed to the web client.
GOOGLE_NATIVE_CLIENT_IDS=""

# The web client id, paired with GOOGLE_CLIENT_SECRET above.
GOOGLE_CLIENT_ID=""

# The native app is not subject to CORS. Narrow this the moment a browser client
# exists.
CORS_ORIGINS="*"

# Bounds the bill and the database pool together: each instance opens
# connection_limit connections of its own, and a shared-core Cloud SQL tier
# allows about 25 in total.
MAX_INSTANCES="4"

# ── Filled in after the first deploy ─────────────────────────────────────────
# These are the service's own https address, which does not exist until it has
# been deployed once. Leave them empty, deploy, then paste the URL the script
# prints and deploy again.
#
# FRONTEND_URL          emailed password-reset links
# SHARE_LINK_BASE_URL   the road links the app shares
# GOOGLE_REDIRECT_URL   where Google returns from the browser flow
FRONTEND_URL=""
SHARE_LINK_BASE_URL=""
GOOGLE_REDIRECT_URL=""
