# ─────────────────────────────────────────────────────────────────────────────
# Every variable in the sections below is validated at boot by
# src/config/env.validation.ts. A missing or malformed value aborts startup with
# all problems listed at once, rather than surfacing as a 500 on whichever
# request happens to need it first.
#
# Copy to .env and fill in. Variables with a default may be omitted.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# One of: development | test | production        (default: development)
NODE_ENV=development
# (default: 3000)
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# Required. Must be a postgresql:// connection string — PostgreSQL specifically,
# not MySQL. The schema uses citext columns, a citext extension and a DEFERRABLE
# constraint, none of which exist elsewhere. Postgres 16 is what the migrations
# were written against; 13 or newer works, since that is where gen_random_uuid()
# became built in.
DATABASE_URL=""

# Managed Postgres (Cloud SQL and the like). Three shapes, pick one:
#
#   Through the Cloud SQL Auth Proxy — see docker-compose.cloudsql.yml:
#     postgresql://USER:PASSWORD@cloudsql-proxy:5432/roaddb?schema=public&connection_limit=5
#
#   Public IP directly. sslmode=require encrypts but does not verify the
#   server; add sslrootcert=/path/to/server-ca.pem to do that too:
#     postgresql://USER:PASSWORD@34.0.0.1:5432/roaddb?schema=public&sslmode=require&connection_limit=5
#
#   Unix socket, on Cloud Run or App Engine:
#     postgresql://USER:PASSWORD@localhost/roaddb?schema=public&host=/cloudsql/PROJECT:REGION:INSTANCE
#
# connection_limit matters: Prisma opens a pool per instance, sized cpus*2+1 by
# default, while a shared-core Cloud SQL tier allows about 25 connections in
# total. Two containers on a 4-core host would exhaust it on their own.

# ── JWT signing ──────────────────────────────────────────────────────────────
# Required, minimum 32 characters each. Generate with:
#   openssl rand -base64 48
# Use three *different* values: reusing one secret across token classes would let
# an access token be replayed as a refresh token.
ACCESS_KEY=""
REFRESH_KEY=""
ROAD_SHARE_KEY=""

# Token lifetimes. A number is seconds; a suffixed value is a duration.
# Do not leave these blank — an empty lifetime mints tokens that never expire.
ACCESS_EXPIRES_IN=15m      # (default: 15m)
REFRESH_EXPIRES_IN=7d      # (default: 7d)
ROAD_SHARE_EXPIRE_IN=7d    # (default: 7d)

# ── Web ──────────────────────────────────────────────────────────────────────
# Required. Base URL of the client, used to build emailed password-reset links.
FRONTEND_URL="http://localhost:8081"

# Optional. Where a shared road link points, when that is not the web client —
# the address people receive in a chat message. It has to be somewhere their
# phone can open, so a public https host, not a LAN address. Falls back to
# FRONTEND_URL.
#
# For the link to open the Android app rather than a browser, this host must
# serve /.well-known/assetlinks.json naming the app's package and signing
# SHA-256. Until then the app still opens links of the form
# net.travelroutes.travelroutes://share/<token>.
# SHARE_LINK_BASE_URL="https://roadplanner.example.com"

# Comma-separated allowlist of browser origins, or * to allow any.
# The native app is not subject to CORS; tighten this if a web client is added.
CORS_ORIGINS="*"           # (default: *)

# ── Mail ─────────────────────────────────────────────────────────────────────
# Required. Password-reset delivery depends on these.
MAIL_HOST="sandbox.smtp.mailtrap.io"
MAIL_PORT=2525             # (default: 587)
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM="no-reply@travel-routes.local"
# Leave true. Set to false only against a local SMTP server with a self-signed
# certificate — it disables certificate verification entirely.
MAIL_TLS_REJECT_UNAUTHORIZED=true   # (default: true)

# ── Google Maps (optional) ───────────────────────────────────────────────────
# Server-side key for the Directions, Geocoding and Places web services. Every
# /api/maps endpoint — and the route and duration endpoints on a road — answers
# 503 until it is set; the rest of the API boots and works without it.
#
# This is not the key the mobile app ships. That one draws the map and is
# restricted to the Maps SDK; this one is billed per request and must never
# reach a client, which is the reason these endpoints exist at all. Restrict it
# by IP (or by the Cloud Run service account) to the three APIs above.
MAP_API_KEY=""

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Optional as a group; Google sign-in is unavailable unless all four are set.
# Where uploaded profile photos are written. Relative to the process working
# directory. Mount this as a volume in any deployment where they must survive a
# redeploy — a container filesystem does not.
UPLOAD_DIR="uploads"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated OAuth client ids for the mobile apps, e.g.
# "123-ios.apps.googleusercontent.com,456-android.apps.googleusercontent.com".
# A phone signs in with its own platform client id, so its token's audience is
# usually not GOOGLE_CLIENT_ID above — these are the extra ids that
# POST /auth/google/token will accept.
#
# GOOGLE_CLIENT_ID is always accepted alongside them, since a token addressed to
# the web client of the same project is still this project's. Set at least one of
# the two or native sign-in answers 503.
#
# Android needs one client id *per signing certificate*, not one per app: a debug
# build and a release build have different SHA-1 fingerprints and therefore need
# two clients, both listed here. A token whose audience is missing from this list
# is refused with a 401, and the reason is named in the server log — grep for
# "Rejected Google id token".
GOOGLE_NATIVE_CLIENT_IDS=""
GOOGLE_REDIRECT_URL="http://localhost:3000/api/auth/google/callback"
GOOGLE_SCOPES_API="https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile"

# Overrides for what google-auth-library would otherwise supply. Each falls back to
# the library default when unset.
GOOGLE_OAUTH2_USERINFO_URL=""   # (default: https://www.googleapis.com/oauth2/v2/userinfo)
GOOGLE_OAUTH2_ACCESS_TYPE=""    # online | offline  (default: offline)
GOOGLE_OAUTH2_PROMPT=""         # none | consent | select_account  (default: consent)

# ─────────────────────────────────────────────────────────────────────────────
# Declared but not yet read by any code.
#
# Added on main while this branch was in flight. They are listed here so the
# intent is not lost, but kept below the line because nothing reads them — the
# same problem the old CREATE_TABLES entry had, where a variable in this file
# looked like live configuration and was not.
#
# The remaining values below describe endpoints and flow parameters that
# google-auth-library handles internally, so there is nothing for this application
# to read them into. Move an entry above the line once code reads it.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH2_URL=""
GOOGLE_OAUTH2_TOKEN_URL=""
GOOGLE_OAUTH2_GRANT_TYPE=""
GOOGLE_OAUTH2_RESPONSE_TYPE=""
GOOGLE_OAUTH2_APPROVAL_PROMPT=""

CREATE_TABLES=False
